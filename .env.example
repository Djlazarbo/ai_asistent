# Copy to .env — never commit .env
# stage = PC (Ollama filter via agents.yaml); prod = server Docker (agents.prod.yaml / DeepSeek)
APP_ENV=stage

# Postgres
# Stage (PC compose): host=localhost port=5433
# Prod (docker-compose.prod.yml): host=postgres port=5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=your_password_here
PGADMIN_PASSWORD=your_pgadmin_password

# AI
DEEPSEEK_API_KEY=your_deepseek_api_key

# Prod Docker: point pollers at in-stack score webhook (replaces n8n)
# N8N_WEBHOOK_URL=http://score:5679/webhook/vacancy

# Optional overrides (else taken from config.yaml)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
