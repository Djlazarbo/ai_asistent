# Copy to .env — never commit .env
# stage = PC (Ollama filter via agents.yaml); prod = server (agents.prod.yaml / DeepSeek)
APP_ENV=stage

# Postgres (stage docker-compose.yml uses host port 5433; prod compose uses 127.0.0.1:5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=your_password_here
PGADMIN_PASSWORD=your_pgadmin_password

# AI
DEEPSEEK_API_KEY=your_deepseek_api_key

# Optional overrides (else taken from config.yaml)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/vacancy
