# Poller image: Playwright Chromium for hh.ru scraping.
FROM mcr.microsoft.com/playwright/python:v1.49.1-jammy

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agents.py agents.yaml agents.prod.yaml ai.py \
    db_postgres.py prompts.py sheets.py \
    hh_poller.py habr_poller.py getmatch_poller.py \
    title_filter.py user_data.py followup_meta.py \
    version.py VERSION CHANGELOG.md ./

ARG APP_VERSION=dev
ARG APP_GIT_SHA=
ENV APP_ENV=prod \
    PYTHONUNBUFFERED=1 \
    POSTGRES_HOST=postgres \
    POSTGRES_PORT=5432 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    APP_VERSION=$APP_VERSION \
    APP_GIT_SHA=$APP_GIT_SHA
LABEL org.opencontainers.image.version=$APP_VERSION

CMD ["python", "hh_poller.py", "--daemon"]
