[Unit]
Description=Job Hunter HH/Habr/Getmatch poller daemon
After=network.target jobhunter-score.service

[Service]
Type=simple
User=djlazarboy
WorkingDirectory=/opt/job-hunter
EnvironmentFile=/opt/job-hunter/.env
Environment=APP_ENV=prod
ExecStart=/opt/job-hunter/.venv/bin/python hh_poller.py --daemon
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
